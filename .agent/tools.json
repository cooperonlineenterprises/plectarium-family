        "designated_integrity_refresh_after_source_freeze",
        "scoped_local_commands"
      ],
      "denied": [
        "dependency_installation",
        "product_code_execution",
        "undeclared_external_effect",
        "secret_in_command"
      ]
    },
    "python": {
      "availability": "required",
      "harness_runtime": "python3_3.11_or_newer_standard_library_only",
      "packet_runtime": "/Users/jamesryancooper/.pyenv/versions/3.14.0/bin/python3",
      "packet_dependencies_observed": ["PyYAML_6.0.3", "jsonschema_4.25.1"],
      "installation_authorized": false,
      "portability_status": "host_specific_packet_runtime"
    },
    "git": {
      "availability": "optional",
      "allowed": ["status", "diff"],
      "task_scoped": ["add", "commit", "branch"],
      "explicit_current_authorization": ["push", "remote_mutation"],
      "denied": ["force_push", "history_rewrite", "unexpected_remote_overwrite"]
