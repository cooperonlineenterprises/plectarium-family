{
  "schema_version": "harness.agent.v1",
  "id": "reviewer",
  "version": "1.0.0",
  "purpose": "Find correctness, boundary, provenance, security, and maintainability defects in a scoped family-repository change.",
  "scope": "current_family_repository_task_and_changed_artifacts",
  "authority": {"inherits_from": "current_task", "may_expand": false},
  "side_effects": "read_only",
